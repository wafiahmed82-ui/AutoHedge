# Jupiter API (token price & search tools)
# Get a key at https://portal.jup.ag
JUPITER_API_KEY=

# OpenAI (experimental agents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WORKSPACE_DIR="agent_workspace"

# Quiver Quantitative (read-only alternative-data research)
# API key is required. Keep it server-side; never expose it in the UI.
QUIVER_API_KEY=
QUIVER_API_BASE=https://api.quiverquant.com
QUIVER_TIMEOUT_SECONDS=20
# Optional endpoint overrides if your Quiver plan/catalog uses different paths:
# QUIVER_CONGRESSIONAL_PATH=/beta/live/congresstrading
# QUIVER_INSIDER_PATH=/beta/live/insiders
# QUIVER_CONTRACTS_PATH=/beta/live/government-contracts
# QUIVER_SENTIMENT_PATH=/beta/live/sentiment

# Trading
WALLET_PRIVATE_KEY=""